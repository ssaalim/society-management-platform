# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (Neon)
DATABASE_URL=postgres://user:password@ep-cold-shadow-123456.us-east-2.aws.neon.tech/neondb

# Redis / BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d

# Dev mode bypass (ONLY active in development with NODE_ENV=development)
DEV_AUTH=false
WEBHOOK_SECRET=your-supabase-webhook-signing-secret

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cloudflare R2 file storage (production). Without these, development stores uploads in apps/backend/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=society-documents
# Public bucket / custom domain base URL used to build file links, e.g. https://files.example.com
R2_PUBLIC_URL=
# Monthly upload count safety cap (free tier guard)
R2_MONTHLY_UPLOAD_CAP=50000
# Development only: the URL the browser uses to reach this API for local uploads (default http://localhost:PORT)
BACKEND_PUBLIC_URL=

# Turn off meeting and vote-deadline reminders (default on)
# MEETING_REMINDERS=off
