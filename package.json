{
  "name": "society-management-platform",
  "version": "1.0.0",
  "description": "Production-grade Society Management SaaS Platform for India",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:backend": "npm run start:prod --workspace=backend",
    "start": "npm run start:prod --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "migration": "npm run migration --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker": "docker-compose up --build",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "next": "^16.2.12",
    "prettier": "^3.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
