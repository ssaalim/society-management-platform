# The society API. On a real phone use your computer's LAN address (e.g. http://192.168.1.20:4000/api/v1)
# or the deployed backend. Defaults: http://localhost:4001/api/v1 (web/iOS), http://10.0.2.2:4001/api/v1 (Android emulator).
EXPO_PUBLIC_API_URL=
# Optional: shown in Help as "Email support"
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional: "Open the society website" in the menu
EXPO_PUBLIC_WEB_URL=
