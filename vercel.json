{
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "apps/frontend/.next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-render-app-url.onrender.com/api/:path*"
    }
  ]
}
